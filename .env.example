envText = @"
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# MongoDB connection string (for example from MongoDB Atlas)
MONGODB_URI=

# Database name
MONGODB_DB=jobtrack

# Secret used to sign sessions. Generate one with: npx auth secret
AUTH_SECRET=
"@

[System.IO.File]::WriteAllText(
  (Join-Path (Get-Location) ".env.example"),
  $envText,
  (New-Object System.Text.UTF8Encoding($false))
)